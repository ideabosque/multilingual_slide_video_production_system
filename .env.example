# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# ----------------------------------
# Localization
# ----------------------------------

DEFAULT_LANGUAGE=en-US
SUPPORTED_LANGUAGES=en-US,zh-TW,ja-JP


# ----------------------------------
# OpenAI
# ----------------------------------

OPENAI_API_KEY=<api-key>

TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin


# ----------------------------------
# Video
# ----------------------------------

VIDEO_OUTPUT_FORMAT=mp4
VIDEO_RESOLUTION=1080p

# Viewport Chromium renders each slide at (msv slides render-images). Must
# match VIDEO_RESOLUTION's width/height in config/video.yaml, or the final
# render's scale filter will be doing real resizing instead of a no-op.
SLIDE_VIEWPORT=1920x1080


# ----------------------------------
# YouTube
# ----------------------------------

# Path to the OAuth 2.0 Client JSON downloaded from Google Cloud Console
# (APIs & Services > Credentials > + Create Credentials > OAuth client ID >
# Desktop app > Download JSON). Holds client_id/client_secret so neither
# ever needs to be typed into this file. Never commit the actual file (see
# .gitignore) — keep it outside the repo, or under config/ where it's
# git-ignored by default.
YOUTUBE_CLIENT_SECRETS_FILE=config/youtube_client_secret.json

# Minted once via `msv publishing get-refresh-token`, then pasted here.
YOUTUBE_REFRESH_TOKEN=<refresh-token>

YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_CATEGORY_ID=28
YOUTUBE_PLAYLIST_ID=<playlist-id>


# ----------------------------------
# Pipeline
# ----------------------------------

PIPELINE_AUTO_PUBLISH=false
# When false (default), only the run's default language is produced first;
# every other language's translation/rendering/tts stage is held until a
# human reviews the default language's render and runs
# `msv pipeline approve-production`. Prevents burning TTS/render cost on 8
# languages before catching a bug that's visible in the first one.
PIPELINE_AUTO_APPROVE_PRODUCTION=false
PIPELINE_RESUME_ON_FAILURE=true
PIPELINE_MAX_RETRIES=3

ENABLE_SLIDE_ANALYSIS=true
ENABLE_TTS=true
ENABLE_SLIDESHOW_RENDERING=true
ENABLE_YOUTUBE_PUBLISHING=true


# ----------------------------------
# Directory layout (optional)
# ----------------------------------
# Base directory config/, output/, state/, and logs/ all resolve under.
# Defaults to the current working directory if unset - set this to run
# `msv` from anywhere and still have it read/write one project's data in
# a fixed location. Must be a real environment variable (export it, or set
# it in your shell profile / process launcher) rather than a line in this
# file: it's what's used to find .env itself, so a value set only in here
# arrives too late for that one decision (see config.py's root_dir()).
# MSV_ROOT_DIR=/path/to/project

# Per-directory overrides, if one needs to live somewhere other than
# MSV_ROOT_DIR (e.g. output/ on a bigger disk). Each defaults to that name
# under MSV_ROOT_DIR. Source decks have no dedicated directory — pass any
# path to --source-deck/--deck-dir.
# MSV_CONFIG_DIR=config
# MSV_OUTPUT_DIR=output
# MSV_STATE_DIR=state
# MSV_LOGS_DIR=logs
